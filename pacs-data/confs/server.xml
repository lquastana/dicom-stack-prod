<?xml version="1.0" encoding="UTF-8"?>
<config>
  <web-server autostart="true" port="8080">
    <allowed-origins>*</allowed-origins>
  </web-server>

  <archive>
    <save-thumbnails>false</save-thumbnails>
    <thumbnail-size>64</thumbnail-size>
    <indexer-effort>100</indexer-effort>

    <main-directory>/opt/dicoogle/data</main-directory>
    <support-wsi>false</support-wsi>
    <node-name>DICOOGLE</node-name>

    <dim-providers>
      <dim-provider>lucene</dim-provider>
    </dim-providers>
    <default-storages>
      <default-storage>filestorage</default-storage>
    </default-storages>

    <enable-watch-directory>false</enable-watch-directory>
    <watch-directory></watch-directory>
    <use-iio-registry>false</use-iio-registry>
    <encrypt-users-file>false</encrypt-users-file>
    <call-shutdown>false</call-shutdown>
  </archive>

  <dicom-services>
    <aetitle>DICOOGLE-STORAGE</aetitle>
    <device-description/>
    <allowed-local-interfaces>any</allowed-local-interfaces>
    <allowed-hostnames>any</allowed-hostnames>

    <default-ts>
      <ts>1.2.840.10008.1.2</ts>
      <ts>1.2.840.10008.1.2.1</ts>
      <ts>1.2.840.10008.1.2.4.50</ts>
      <ts>1.2.840.10008.1.2.4.70</ts>
      <ts>1.2.840.10008.1.2.4.80</ts>
      <ts>1.2.840.10008.1.2.4.57</ts>
      <ts>1.2.840.10008.1.2.4.90</ts>
      <ts>1.2.840.10008.1.2.4.91</ts>
      <ts>1.2.840.10008.1.2.5</ts>
      <ts>1.2.840.10008.1.2.4.100</ts>
      <ts>1.2.840.10008.1.2.4.51</ts>
    </default-ts>
    <sop-classes>
      <sop-class>
        <uid>1.2.840.10008.5.1.4.1.1.12.1</uid>
      </sop-class>
      <sop-class>
        <uid>1.2.840.10008.5.1.4.1.1.12.2</uid>
      </sop-class>
      <sop-class>
        <uid>1.2.840.10008.5.1.4.1.1.3.1</uid>
      </sop-class>
    </sop-classes>

    <additional-sop-classes/>
    <additional-transfer-syntaxes/>
    <move-destinations/>

    <storage autostart="true" port="6666"/>
    <query-retrieve autostart="true" port="1045">
      <rsp-delay>0</rsp-delay>
      <dimse-rsp-timeout>60</dimse-rsp-timeout>
      <idle-timeout>60</idle-timeout>
      <accept-timeout>60</accept-timeout>
      <connection-timeout>60</connection-timeout>
      <transfer-capabilities>1.2.840.10008.1.2</transfer-capabilities>
      <transfer-capabilities>1.2.840.10008.1.2.1</transfer-capabilities>
      <transfer-capabilities>1.2.840.10008.1.2.2</transfer-capabilities>
      <sop-class>1.2.840.10008.5.1.4.1.2.2.1</sop-class>
      <sop-class>1.2.840.10008.5.1.4.1.2.1.1</sop-class>
      <max-client-assocs>20</max-client-assocs>
      <max-pdu-length-receive>16364</max-pdu-length-receive>
      <max-pdu-length-send>16364</max-pdu-length-send>
    </query-retrieve>
  </dicom-services>
</config>
