# Fichier de configuration pour l'écosystème DICOM

# --- Configuration Générale ---
COMPOSE_PROJECT_NAME=dicom-stack

# --- Configuration Dicoogle PACS ---
# Port web pour l'interface de Dicoogle
DICOOGLE_WEB_PORT=8080
# Port DICOM pour la réception des fichiers (C-STORE)
DICOOGLE_DICOM_PORT=6666
# Titre AE (Application Entity Title) de notre PACS Dicoogle
DICOOGLE_AETITLE=DICOOGLE-STORAGE

# --- Configuration OHIF Viewer ---
# Port pour accéder à l'interface OHIF
OHIF_PORT=3002

# --- Configuration du Simulateur/Sender ---
# Cible du simulateur : nom du service docker du PACS
PACS_HOSTNAME=dicoogle
# Cible du simulateur : Titre AE du PACS
PACS_AETITLE=DICOOGLE-STORAGE
# Cible du simulateur : Port DICOM du PACS
PACS_PORT=6666
# Titre AE du simulateur (le "scanner")
SENDER_AETITLE=CT_SCANNER